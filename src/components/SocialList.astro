---
import { Icon } from "astro-icon/components";

const socialLinks = [
	{
		friendlyName: "GitHub",
		link: "https://github.com/zhaochoudecat",
		name: "mdi:github",
	},
];
---

<ul class="social-list" aria-label="社交链接">
	{socialLinks.map(({ friendlyName, link, name }) => (
		<li>
			<a href={link} rel="noreferrer me" target="_blank" aria-label={friendlyName}>
				<Icon aria-hidden="true" class="social-list__icon" focusable="false" name={name} />
			</a>
		</li>
	))}
</ul>
