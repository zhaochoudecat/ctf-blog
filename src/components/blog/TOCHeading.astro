---
import type { TocItem } from "@/utils/generateToc";

interface Props {
	heading: TocItem;
}

const {
	heading: { children, depth, slug, text },
} = Astro.props;
---

<li class:list={[`toc-depth-${depth}`]}>
	<a href={`#${slug}`}>{text}</a>
	{children.length > 0 && (
		<ol>
			{children.map((subheading) => <Astro.self heading={subheading} />)}
		</ol>
	)}
</li>
