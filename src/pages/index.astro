---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import HomePostCard from "@/components/blog/HomePostCard.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

const MAX_RECENT_POSTS = 6;
const allPosts = (await getAllPosts()).sort(collectionDateSort) as CollectionEntry<"post">[];
const featuredPosts = allPosts.filter((post) => post.data.pinned).slice(0, 3);
const recentPosts = allPosts.filter((post) => !post.data.pinned).slice(0, MAX_RECENT_POSTS);
---

<PageLayout meta={{ title: "首页" }}>
	<section class="border-muted/25 border-b pb-10 sm:pb-12">
		<div class="mb-5 flex items-center gap-3">
			<h1 class="text-accent-2 text-4xl font-bold tracking-tight sm:text-5xl">
				你好，我是 0xCat。
			</h1>
			<a class="text-accent hover:text-link mt-2" href="/rss.xml" title="RSS 订阅">
				<span class="sr-only">RSS 订阅</span>
				<Icon aria-hidden="true" class="h-5 w-5" focusable="false" name="mdi:rss" />
			</a>
		</div>
		<p class="max-w-2xl text-base leading-8 sm:text-lg">
			这里记录 CTF 解题过程、Web
			安全研究与靶场实践。文章尽量保留完整命令、代码和复现步骤，方便回看，也方便你复现。
		</p>
		<div class="mt-5"><SocialList /></div>
	</section>

	{
		featuredPosts.length > 0 && (
			<section class="border-muted/25 border-b py-10 sm:py-12">
				<h2 class="text-accent-2 text-2xl font-semibold tracking-tight">精选文章</h2>
				<ul role="list">
					{featuredPosts.map((post) => (
						<HomePostCard post={post} />
					))}
				</ul>
			</section>
		)
	}

	<section class="py-10 sm:py-12">
		<h2 class="text-accent-2 text-2xl font-semibold tracking-tight">最近更新</h2>
		{
			recentPosts.length > 0 ? (
				<ul role="list">
					{recentPosts.map((post) => (
						<HomePostCard post={post} />
					))}
				</ul>
			) : (
				<p class="text-muted mt-6">文章正在整理中。</p>
			)
		}
	</section>

	<div class="text-center">
		<a class="cactus-link inline-flex items-center gap-1 font-semibold" href="/posts/">
			查看全部文章 <span aria-hidden="true">→</span>
		</a>
	</div>
</PageLayout>
