---
import { render } from "astro:content";
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { Icon } from "astro-icon/components";
import PostPreview from "@/components/blog/PostPreview.astro";
import Pagination from "@/components/Paginator.astro";
import { getAllPosts, getTagMeta, getUniqueTags } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { collectionDateSort } from "@/utils/date";

export const getStaticPaths = (async ({ paginate }) => {
	const allPosts = await getAllPosts();
	const sortedPosts = allPosts.sort(collectionDateSort);
	const uniqueTags = getUniqueTags(sortedPosts);

	return uniqueTags.flatMap((tag) => {
		const postsWithTag = sortedPosts.filter((post) => post.data.tags.includes(tag));
		return paginate(postsWithTag, { pageSize: 10, params: { tag } });
	});
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { page } = Astro.props as Props;
const { tag } = Astro.params;
const tagMeta = await getTagMeta(tag);
const TagContent = tagMeta ? (await render(tagMeta)).Content : null;
const fallbackTitle = `关于 ${tag} 的文章`;
const meta = {
	description: tagMeta?.data.description ?? `查看 #${tag} 标签下的全部文章`,
	title: tagMeta?.data.title ?? fallbackTitle,
};
const paginationProps = {
	...(page.url.prev && { prevUrl: { text: "← 上一页", url: page.url.prev } }),
	...(page.url.next && { nextUrl: { text: "下一页 →", url: page.url.next } }),
};
---

<PageLayout meta={meta}>
	<nav class="mb-8" aria-label="面包屑导航">
		<ul class="flex items-center">
			<li class="flex items-center">
				<a class="text-accent" href="/tags/">标签</a>
				<Icon aria-hidden="true" name="mdi:chevron-right" class="mx-1.5" />
			</li>
			<li aria-current="page"><span aria-hidden="true">#</span>{tag}</li>
		</ul>
	</nav>
	<h1 class="title capitalize">{tagMeta?.data.title ?? fallbackTitle}</h1>
	<div class="prose prose-sm mb-16 max-w-none">
		{tagMeta?.data.description && <p>{tagMeta.data.description}</p>}
		{TagContent && <TagContent />}
	</div>
	<ul class="space-y-4">
		{
			page.data.map((post) => (
				<li class="grid gap-1 sm:grid-cols-[auto_1fr]">
					<PostPreview as="h2" post={post} />
				</li>
			))
		}
	</ul>
	<Pagination {...paginationProps} />
</PageLayout>
