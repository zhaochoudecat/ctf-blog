---
import type { CollectionEntry } from "astro:content";
import HomePostCard from "@/components/blog/HomePostCard.astro";
import Search from "@/components/Search.astro";
import SocialList from "@/components/SocialList.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { getAllPosts } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";
import { menuLinks, siteConfig } from "@/site.config";
import { collectionDateSort } from "@/utils/date";

const allPosts = (await getAllPosts()).sort(collectionDateSort) as CollectionEntry<"post">[];
const homepagePosts = allPosts.slice(0, 8);
---

<PageLayout meta={{ title: "首页" }}>
	<section class="psi-home" aria-labelledby="profile-name">
		<div class="profile">
			<img class="profile__avatar" src="/icon.svg" alt="0xCat avatar" width="60" height="60" />
			<div class="profile__text">
				<div class="profile__identity">
					<h1 id="profile-name">0xCat</h1>
					<span>@{siteConfig.author}</span>
				</div>
				<p>CTF / Web Security / 靶场实践</p>
			</div>
		</div>

		<div class="home-links">
			<nav class="home-links__left" aria-label="主导航">
				{menuLinks.filter((link) => link.path !== "/").map((link) => (
					<a href={link.path}>{link.title}</a>
				))}
			</nav>
			<div class="home-links__right">
				<Search />
				<SocialList />
				<ThemeToggle />
			</div>
		</div>

		<div class="brief prose">
			<p>你好，我是 0xCat，一名安全爱好者。</p>
			<p>这里记录 CTF 解题过程、Web 安全研究与靶场实践，保留命令、代码和完整复现路径。</p>
			<p>文章在 Obsidian 中维护，以 Markdown 编写，并通过 Astro 构建发布。</p>
		</div>

		<section class="layout-list" aria-labelledby="latest-posts">
			<h2 id="latest-posts" class="section-title">最近文章</h2>
			{homepagePosts.length > 0 ? (
				<>
					<ul class="post-list" role="list">
						{homepagePosts.map((post) => (
							<HomePostCard post={post} featured={post.data.pinned} />
						))}
					</ul>
					<div class="read-more"><a href="/posts/">更多 »</a></div>
				</>
			) : (
				<p class="empty-state">文章正在整理中。</p>
			)}
		</section>
	</section>
</PageLayout>
