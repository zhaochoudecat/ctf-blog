---
import Search from "@/components/Search.astro";
import ThemeToggle from "@/components/ThemeToggle.astro";
import { menuLinks, siteConfig } from "@/site.config";

interface Props {
	compact?: boolean;
}

const { compact = false } = Astro.props;
const isHome = Astro.url.pathname === "/";
---

{compact ? (
	<header class="post-back-header">
		<nav aria-label="文章导航">
			<a href="/posts/">← 返回文章</a>
		</nav>
	</header>
) : !isHome ? (
	<header class="site-header" id="main-header">
		<a class="site-header__brand" href="/" aria-label={`${siteConfig.title} 首页`}>
			<span aria-hidden="true">←</span> {siteConfig.title}
		</a>
		<nav aria-label="主导航" class="site-header__nav">
			{menuLinks.filter((link) => link.path !== "/").map((link) => (
				<a aria-current={Astro.url.pathname === link.path ? "page" : undefined} href={link.path}>
					{link.title}
				</a>
			))}
		</nav>
		<div class="site-header__tools">
			<Search />
			<ThemeToggle />
		</div>
	</header>
) : null}
