---
import type { CollectionEntry } from "astro:content";
import FormattedDate from "@/components/FormattedDate.astro";

interface Props {
	post: CollectionEntry<"post">;
	featured?: boolean;
}

const { post, featured = false } = Astro.props;
---

<li class:list={["post-row", featured && "post-row--featured"]}>
	<a href={`/posts/${post.id}/`}>
		<span class="post-row__title">{post.data.title}</span>
		<span aria-hidden="true" class="post-row__line"></span>
		<FormattedDate class="post-row__date" date={post.data.publishDate} />
	</a>
</li>
